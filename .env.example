# Copier ce fichier en `.env` puis remplacer les valeurs.
# Ne jamais commiter le fichier `.env`.

# Environnement : development | test | production
NODE_ENV=development

# Port du serveur HTTP
PORT=3000

# Connexion PostgreSQL : postgres://UTILISATEUR:MOT_DE_PASSE@HOTE:PORT/BASE
DATABASE_URL=postgres://utilisateur:mot_de_passe@localhost:5432/facturation_dev

# Mettre à true si l'hébergeur de la base exige une connexion chiffrée (SSL)
DATABASE_SSL=false

# Base utilisée par les tests automatisés (sera vidée par les tests !)
DATABASE_URL_TEST=postgres://utilisateur:mot_de_passe@localhost:5432/facturation_test
